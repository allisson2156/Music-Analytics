// Prisma Client generator configuration (TypeScript)
generator client {
  provider = "prisma-client-js"
}

// Database connection configuration (SQLite)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Data models (Tables)

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique // Last.fm username
  displayName  String?    // Optional display name
  registeredAt DateTime?  // Date when the user registered on Last.fm
  createdAt    DateTime   @default(now())
  
  // Relations
  scrobbles    Scrobble[]
}

model Artist {
  id        Int      @id @default(autoincrement())
  name      String   @unique // Artist name (e.g., "Adele")
  mbid      String?  // MusicBrainz ID (optional identifier)
  
  // Relations
  tracks    Track[]
}

model Track {
  id        Int      @id @default(autoincrement())
  title     String   // Track title (e.g., "Hello")
  mbid      String?  // Optional MusicBrainz ID
  
  // Relation with Artist (A track belongs to an Artist)
  artistId  Int
  artist    Artist   @relation(fields: [artistId], references: [id])
  
  // Relations
  scrobbles Scrobble[]

  // Ensures that we don't have two tracks with the same title from the SAME artist in the database.
  // E.g., "Hello" by Lionel Richie and "Hello" by Adele can coexist, but not two "Hello" tracks by Adele.
  @@unique([title, artistId])
}

model Scrobble {
  id        Int      @id @default(autoincrement())
  playedAt  DateTime // When the track was listened to (timestamp)
  
  // Relation with User (Who listened)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  // Relation with Track (What was listened to)
  trackId   Int
  track     Track    @relation(fields: [trackId], references: [id])

  // A user cannot record two tracks played at the exact same second.
  @@unique([userId, playedAt])
}